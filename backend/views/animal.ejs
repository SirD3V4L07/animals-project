<!DOCTYPE html>
<html>
<head>
    <title><%= animal.common_name %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="animal-body">

<div class="left-panel">   
    <div class="id">
        <div class="portrait" style="background-image: url('/assets/portraits/<%= animal.slug %>.jpg');">
           
        </div>
        <span class="portrait-attribution"><%- animal.portrait_attribution %></span>
        <h2><%= animal.common_name %></h2>
        <p><em><%= animal.scientific_name %></em></p>
    </div>

    <div class="taxonomy">
        <p>Kingdom: <em>Animalia</em></p>
        <p>Phylum: <em><%= animal.phylum %></em></p>
        <p>Class: <em><%= animal.class %></em></p>
        <p>Order: <em><%= animal.order %></em></p>
        <p>Family: <em><%= animal.family %></em></p>
        <p>Genus: <em><%= animal.genus %></em></p>
    </div>
</div> 

<div class="main-panel">
    <p><em>Diet: <%= animal.diet %></em></p>
    <p><em>Legacy start: <%= animal.legacy_start %> years ago</em></p>
    <p><em>Legacy end: <%= animal.legacy_end %></em></p>

    <div class="stats">
        <p>Average Weight: <em><%= animal.avg_weight %></em> kg</p>
        <p>Average Height: <em> </em> cm</p>
        <p>Average Speed: <em><%= animal.avg_speed %></em> km/h</p>
        <p>Life Expectancy: <em><%= animal.life_expectancy %></em> years</p>
    </div>
</div>




</body>
</html>